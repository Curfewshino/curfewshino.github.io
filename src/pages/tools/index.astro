---
import Base from '../../layouts/Base.astro';
import TagFilter from '../../components/TagFilter.astro';
import { TOOLS } from '../../tools';
const tags = [...new Set(TOOLS.flatMap((t) => t.tags ?? []))].sort();
---
<Base title="Tools" description="Small tools that run in your browser.">
  <h1>Tools</h1>
  <p class="muted">Small tools that run in your browser. Nothing you enter leaves the page.</p>
  {TOOLS.length > 0 ? (
    <>
      <TagFilter tags={tags} target="#tools" />
      <ul class="list" id="tools">
        {TOOLS.map((t) => (
          <li data-tags={(t.tags ?? []).join('|')}>
            <h3><a href={`/tools/${t.slug}/`}>{t.title}</a></h3>
            <p>{t.summary}</p>
            {t.tags && <div class="tags">{t.tags.map((x) => <span class="tag">{x}</span>)}</div>}
          </li>
        ))}
      </ul>
    </>
  ) : (
    <div class="empty">
      <p>No tools yet. The first ones will be calculators for controller builds, like scan-time and latency budgets.</p>
      <p class="muted">In the meantime, see what I've <a href="/projects/">built</a> or <a href="/blog/">written</a>.</p>
    </div>
  )}
</Base>
