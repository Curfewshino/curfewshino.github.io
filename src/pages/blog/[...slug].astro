---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return posts.map((p, i) => ({ params: { slug: p.id }, props: { post: p, prev: posts[i - 1], next: posts[i + 1] } }));
}
const { post, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const d = post.data;
---
<Base title={d.title} description={d.description}>
  <a class="back" href="/blog/">← All posts</a>
  <h1 style="margin-top:1rem">{d.title}</h1>
  <div class="meta">{d.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
  <div class="tags">{d.tags.map((t) => <span class="tag">{t}</span>)}</div>
  <div class="prose" style="margin-top:2rem"><Content /></div>
  <nav class="section-head" style="margin-top:3rem;border-top:1px solid var(--rule);padding-top:1rem" aria-label="Post navigation">
    <span>{prev && <a href={`/blog/${prev.id}/`}>← {prev.data.title}</a>}</span>
    <span>{next && <a href={`/blog/${next.id}/`}>{next.data.title} →</a>}</span>
  </nav>
</Base>
